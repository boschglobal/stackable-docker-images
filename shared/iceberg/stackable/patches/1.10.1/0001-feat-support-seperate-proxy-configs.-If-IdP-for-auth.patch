+  private static RESTClient buildAuthClient(
+      Map<String, String> properties, String oauth2ServerUri) {
+    Map<String, String> authClientProps = Maps.newHashMap(properties);
+
+    authClientProps.remove(HTTPClient.REST_PROXY_HOSTNAME);
+    authClientProps.remove(HTTPClient.REST_PROXY_PORT);
+    authClientProps.remove(HTTPClient.REST_PROXY_USERNAME);
+    authClientProps.remove(HTTPClient.REST_PROXY_PASSWORD);
+
+    String proxyHostname = properties.get(OAUTH2_PROXY_HOSTNAME);
+    String proxyPort = properties.get(OAUTH2_PROXY_PORT);
+    if (proxyHostname != null && proxyPort != null) {
+      authClientProps.put(HTTPClient.REST_PROXY_HOSTNAME, proxyHostname);
+      authClientProps.put(HTTPClient.REST_PROXY_PORT, proxyPort);
+    }
+
+    String proxyUsername = properties.get(OAUTH2_PROXY_USERNAME);
+    String proxyPassword = properties.get(OAUTH2_PROXY_PASSWORD);
+    if (proxyUsername != null && proxyPassword != null) {
+      authClientProps.put(HTTPClient.REST_PROXY_USERNAME, proxyUsername);
+      authClientProps.put(HTTPClient.REST_PROXY_PASSWORD, proxyPassword);
+    }
+
+    return HTTPClient.builder(authClientProps)
+        .uri(oauth2ServerUri)
+        .withAuthSession(AuthSession.EMPTY)
+        .build();
+  }
+
