+        });
+        restConfig.getOAuth2HttpProxyPassword()
+                .ifPresent(password -> properties.put("rest.auth.oauth2.password", password));
+        restConfig.getOAuth2HttpProxyUsername()
+                .ifPresent(username -> properties.put("rest.auth.oauth2.username", username));
         properties.putAll(securityProperties.get());
         if (restConfig.isVendedCredentialsEnabled()) {
             properties.put("header.X-Iceberg-Access-Delegation", "vended-credentials");
