+
+    public HostAndPort getHttpProxy()
+    {
+        return httpProxy;
+    }
+
+    @Config("azure.http-proxy")
+    @ConfigDescription("HTTP proxy host and port")
+    public AzureFileSystemConfig setHttpProxy(HostAndPort httpProxy)
+    {
+        this.httpProxy = httpProxy;
+        return this;
+    }
+
+    public String getHttpProxyUsername()
+    {
+        return httpProxyUsername;
+    }
+
+    @Config("azure.http-proxy.username")
+    @ConfigDescription("HTTP proxy username")
+    public AzureFileSystemConfig setHttpProxyUsername(String httpProxyUsername)
+    {
+        this.httpProxyUsername = httpProxyUsername;
+        return this;
+    }
+
+    public String getHttpProxyPassword()
+    {
+        return httpProxyPassword;
+    }
+
+    @Config("azure.http-proxy.password")
+    @ConfigDescription("HTTP proxy password")
+    @ConfigSecuritySensitive
+    public AzureFileSystemConfig setHttpProxyPassword(String httpProxyPassword)
+    {
+        this.httpProxyPassword = httpProxyPassword;
+        return this;
+    }
+
+    public Set<String> getNonProxyHosts()
+    {
+        return nonProxyHosts;
+    }
+
+    @Config("azure.http-proxy.non-proxy-hosts")
+    @ConfigDescription("Comma-separated list of hosts that should not use the proxy")
+    public AzureFileSystemConfig setNonProxyHosts(String nonProxyHosts)
+    {
+        this.nonProxyHosts = ImmutableSet.copyOf(Splitter.on(',').omitEmptyStrings().trimResults().split(nullToEmpty(nonProxyHosts)));
+        return this;
+    }
+
+    @AssertTrue(message = "azure.http-proxy must be set when azure.http-proxy.username, azure.http-proxy.password or azure.http-proxy.non-proxy-hosts is set")
+    public boolean isHttpProxyConfigValid()
+    {
+        return httpProxy != null || (httpProxyUsername == null && httpProxyPassword == null && nonProxyHosts.isEmpty());
+    }
+
+    @AssertTrue(message = "azure.http-proxy.username and azure.http-proxy.password must be set together")
+    public boolean isHttpProxyCredentialsValid()
+    {
+        return (httpProxyUsername == null) == (httpProxyPassword == null);
+    }
 }
